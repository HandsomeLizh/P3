Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 28; 32; 40
    Fixed Frame: map
    Frame Rate: 15
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: 参考网格（1米）
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 80
      Color: 100; 105; 115
    - Class: rviz_default_plugins/PointCloud2
      Name: 三维点云（轻量显示）
      Enabled: true
      Topic:
        Value: /T3/demo/rviz_cloud
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Position Transformer: XYZ
      Color Transformer: FlatColor
      Color: 130; 185; 210
      Axis: Z
      Autocompute Value Bounds:
        Value: true
      Style: Points
      Size (Pixels): 1
      Size (m): 0.03
      Alpha: 0.65
      Decay Time: 0
    - Class: rviz_default_plugins/Path
      Name: 原始轨迹（真实高度）
      Enabled: false
      Topic:
        Value: /T3/semantic/trajectory
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      Color: 25; 255; 80
      Line Style: Lines
      Line Width: 0.06
      Buffer Length: 1
    - Class: rviz_default_plugins/Odometry
      Name: 车体定位坐标轴
      Enabled: true
      Topic:
        Value: /T3/semantic/current_pose
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
      Keep: 1
      Shape: Axes
      Position Tolerance: 0
      Angle Tolerance: 0
    - Class: rviz_default_plugins/TF
      Name: TF坐标系（可选）
      Enabled: false
      Show Names: true
      Marker Scale: 0.5
    - Class: rviz_default_plugins/MarkerArray
      Name: 橙色轨迹与青色车头（抬高显示）
      Enabled: true
      Marker Topic:
        Value: /T3/demo/markers
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 85
      Target Frame: base_link
      Pitch: 1.10
      Yaw: 0.8
      Focal Point:
        X: 0
        Y: 0
        Z: 0
Window Geometry:
  X: 60
  Y: 38
  Width: 1050
  Height: 990
